{
    "fields" : [
        {
            "name" : "Winner Name",
            "input_type" : "str",
            "description" : "Name of the winning player",
            "constraints" : [
                {
                    "constraint_context" : {
                        "type": "populated"
                    },
                    "handling_context" : {
                        "remove" : true
                    }
                },
                {
                    "constraint_context" : {
                        "type": "non_empty"
                    },
                    "handling_context" : {
                        "remove" : true
                    }
                }
            ]
        },
        {
            "name" : "Loser Name",
            "input_type" : "str",
            "description" : "Name of the losing player",
            "constraints" : [
                {
                    "constraint_context" : {
                        "type": "populated"
                    },
                    "handling_context" : {
                        "remove" : true
                    }
                },
                {
                    "constraint_context" : {
                        "type": "non_empty"
                    },
                    "handling_context" : {
                        "remove" : true
                    }
                }
            ]
        },
        {
            "name" : "Winner Score",
            "input_type" : "int",
            "description" : "Goals scored by the winning player",
            "constraints" : [
                {
                    "constraint_context" : {
                        "type" : "bounded",
                        "min" : 10,
                        "max" : 10
                    }
                }
            ]
        },
        {
            "name" : "Loser Score",
            "input_type" : "int",
            "description" : "Goals scored by the losing player",
            "constraints" : [
                {
                    "constraint_context" : {
                        "type" : "bounded",
                        "min" : 0,
                        "max" : 9
                    }
                }
            ]
        },
        {
            "name" : "Winner Color",
            "input_type" : "str",
            "description" : "Color used by the winning player",
            "constraints" : [
                {
                    "constraint_context" : {
                        "type" : "choices",
                        "choices" : ["B", "W"]
                    }
                }
            ]
        },
        {
            "name" : "Date",
            "input_type" : "str",
            "description" : "Date of match",
            "conversion" : {
                "type" : "date",
                "format" : "%m/%d/%Y"
            }
        },
        {
            "name" : "Number",
            "input_type" : "int",
            "description" : "Match id/ order",
            "constraints" : [
                {
                    "constraint_context" : {
                        "type" : "unique"
                    }
                },
                {
                    "constraint_context" : {
                        "type" : "bounded",
                        "min" : 0
                    }
                }
            ]
        }
    ],
    "data_constraints" : [
        {
            "constraint_context" : {
                "type" : "greater",
                "greater" : "Winner Score",
                "lesser" : "Loser Score"
            }
        },
        {
            "constraint_context" : {
                "type" : "inequality",
                "fields" : ["Winner Name", "Loser Name"]
            }
        }
    ],
    "series_constraints" : [
        {
            "constraint_context" : {
                "type" : "order",
                "first_order" : "Number",
                "second_order" : "Date"
            }
        }
    ]
}